# =============================================================================
# Portfolio v2.6 Environment Configuration Template
# Copy this file to .env and configure your secret keys and environment variables.
# =============================================================================

# Web3Forms Secret Access Key (https://web3forms.com/)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Developer Contact Information
VITE_DEV_EMAIL=your_email@example.com
VITE_DEV_PHONE=+91-XXXXXXXXXX

# Developer Public Profile Handles
VITE_GITHUB_USERNAME=SidharthSinghShrinet

# Optional: GitHub Personal Access Token (to raise API rate limits from 60 to 5000 req/hr)
VITE_GITHUB_TOKEN=
